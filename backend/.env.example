# Copy to backend/.env and edit. Everything is optional.

# --- Speech to text (local, free) ---
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3  (bigger = better + slower)
WHISPER_DEVICE=auto          # auto | cpu | cuda

# --- Your own server-side LLM (optional) ---
# Leave LLM_PROVIDER empty to make every user bring their own Claude API key.
# Set it to give users a model by default (they can still override with their own key).
#
# Self-hosted / any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenRouter...):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=
#
# Or your own Anthropic key, paid by you:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# Default model for users who connect Claude with their own key
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Encoding ---
VIDEO_PRESET=veryfast
VIDEO_CRF=21
MAX_UPLOAD_MB=4096
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# --- Link import (yt-dlp) ---
MAX_IMPORT_MINUTES=240
IMPORT_MAX_HEIGHT=1080
# Reuse a browser's login for Instagram / private posts: chrome | edge | firefox | brave
# YTDLP_COOKIES_FROM_BROWSER=chrome

# --- Social accounts (OAuth) ---
# Redirect URI to register in each developer console:
#   <PUBLIC_URL>/api/social/<youtube|tiktok|instagram|x>/callback
# TikTok and Instagram require an https URL: use a tunnel (ngrok, cloudflared) and set PUBLIC_URL to it.
PUBLIC_URL=http://127.0.0.1:8000
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# --- Supabase (auth + database) ---
# Dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...    # server only, never in the browser

# --- Stripe (subscriptions) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
