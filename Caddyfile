{$DOMAIN} {
	encode gzip
	# Large uploads and long-running requests are fine: no body limit, generous timeouts.
	reverse_proxy app:8000 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
